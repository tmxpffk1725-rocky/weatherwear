# 네이버 쇼핑 검색 API 키 (https://developers.naver.com/apps)
# 로컬 개발: 이 파일을 .env 로 복사하고 실제 값을 채운다 (.env는 git에 안 올라감)
# 배포(Vercel): 대시보드 Settings → Environment Variables 에 같은 이름으로 입력
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Claude API (코디 설계용) — https://console.anthropic.com
# 미설정 시 추천은 룰 기반(체감온도+절기)으로 자동 폴백됨
ANTHROPIC_API_KEY=your_anthropic_api_key
# 코디 설계 모델 (기본 haiku, 품질 원하면 claude-sonnet-4-6)
LLM_MODEL=claude-haiku-4-5
